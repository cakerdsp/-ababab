   Keywords = {Approximation methods; Analytical models; Upper bound; Mathematical model; Runtime; Accuracy; Integrated circuit modeling; Analytical Placement; Smooth max; function; Half-Perimeter; Wirelength; Model},
   Year = {2014} }




@article{
J.W.-41,
   Author = {J., Chen and W., Zhu and M., M. Ali},
   Title = {A Hybrid Simulated Annealing Algorithm for Nonslicing VLSI Floorplanning},
   Journal = {IEEE Transactions on Systems, Man, and Cybernetics, Part C (Applications and Reviews)},
   Volume = {41},
   Number = {4},
   Pages = {544-553},
   DOI = {10.1109/TSMCC.2010.2066560},
   Note = {IEEE Transactions on Systems, Man, and Cybernetics, Part C (Applications and Reviews)
IEEE Transactions on Systems, Man, and Cybernetics, Part C (Applications and Reviews)},
   Abstract = {Floorplanning in very large scale integrated-circuit (VLSI) design is the first phase in the process of designing the physical layout of a chip. This makes the floorplanning problem of paramount importance, since it determines the performance, size, yield, and reliability of VLSI chips . From the computational point of view, the VLSI floorplanning is an NP-hard problem. In this paper, we present a hybrid simulated annealing algorithm (HSA) for nonslicing VLSI floorplanning. The HSA uses a new greedy method to construct an initial B*-tree, a new operation on the B*-tree to explore the search space, and a novel bias search strategy to balance global exploration and local exploitation. Experimental results on Microelectronic Center of North Carolina (MCNC) benchmarks show that the HSA can quickly produce optimal or nearly optimal solutions for all the tested problems.
Floorplanning in very large scale integrated-circuit (VLSI) design is the first phase in the process of designing the physical layout of a chip. This makes the floorplanning problem of paramount importance, since it determines the performance, size, yield, and reliability of VLSI chips . From the computational point of view, the VLSI floorplanning is an NP-hard problem. In this paper, we present a hybrid simulated annealing algorithm (HSA) for nonslicing VLSI floorplanning. The HSA uses a new greedy method to construct an initial B*-tree, a new operation on the B*-tree to explore the search space, and a novel bias search strategy to balance global exploration and local exploitation. Experimental results on Microelectronic Center of North Carolina (MCNC) benchmarks show that the HSA can quickly produce optimal or nearly optimal solutions for all the tested problems.},
   Keywords = {Simulated annealing; Search methods; Space exploration; Pediatrics; Heuristic algorithms; Benchmark testing; Cost function; B*-tree; bias search strategy; local search; simulated annealing; very large scale integrated-circuit (VLSI) floorplanning},
   Year = {2011} }




