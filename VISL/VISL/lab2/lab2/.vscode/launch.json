    "version": "0.2.0",
        "configurations": [
        {
            "name": "g++ - Build and debug active file",
            "type": "cppdbg",
            "request": "launch",
            "program": "${cwd}/main",
            "args": [
                "../lab2_generate_benchmark/small.txt",
                "../output/small_placement.txt"
            ],
            "stopAtEntry": false,
            "cwd": "/home/cake/VISL/homework2/lab2",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ],
            "preLaunchTask": "build",
            "miDebuggerPath": "/usr/bin/gdb"
        }
    ]
}